# QuikTalk AI Environment Variables Configuration
# Copy this file to .env for local overrides if needed

# Primary public production origin URL (used for canonical links, sitemaps, OpenGraph, JSON-LD)
SITE_URL=https://www.quiktalkai.com

# Destination for booking and contact calls to action
BOOKING_URL=https://www.quiktalkai.com/#demo

# Local preview server port (default: 4173)
PORT=4173

# Cloudflare deployment credentials (optional, for CI/CD or CLI deployment)
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
